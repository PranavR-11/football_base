{$DOMAIN:api.yourdomain.com} {
    # Enable compression
    encode gzip zstd

    # Reverse proxy to FastAPI backend
    reverse_proxy api:8000 {
        # WebSocket support
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}

        # Health check
        health_uri /health
        health_interval 30s
        health_timeout 5s

        # Timeouts for long-running agent queries
        transport http {
            read_timeout 120s
            write_timeout 120s
        }
    }
}
