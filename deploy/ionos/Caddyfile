{$DOMAIN:api.yourdomain.com} {
    # Enable compression
    encode gzip zstd

    # Reverse proxy to FastAPI backend
    reverse_proxy api:8000 {
        # WebSocket support
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}

        # Health check
        health_uri /health
        health_interval 30s
        health_timeout 5s

        # Extended timeouts for long-running agent queries and WebSocket keepalive
        transport http {
            read_timeout 600s
            write_timeout 600s
            keepalive 2m
            keepalive_idle_conns 10
        }
    }
}
