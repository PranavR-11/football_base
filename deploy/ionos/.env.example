# Docker Compose Environment Variables
# Copy this file to .env and fill with real values

# Your domain name (e.g., api.yourdomain.com)
DOMAIN=api.yourdomain.com

# OpenAI API Key (REQUIRED)
OPENAI_API_KEY=sk-your_real_openai_key_here

# MCP API Key (if using MCP service)
MCP_API_KEY=your_mcp_key_here

# Data paths (defaults should work with mounted volumes)
DATA_PATH=/app/data/FINAL_with_rag.csv
VECTORSTORE_DIR=/app/data/vectorstore
MODEL_PATH=/app/models/ridge_player_model.joblib

# Agent debug mode (set to True for verbose logging)
AGENT_DEBUG=False

# Cache database path (default works with mounted volumes)
AGENT_CACHE_DB=/app/cache/agent_cache.sqlite
