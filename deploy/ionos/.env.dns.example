# DNS Updater Environment Variables
# Copy this file to .env.dns and fill with real values
# This is used by the dns-updater systemd service

# Cloudflare API Token (with DNS edit permissions)
CF_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Zone ID (from your domain's overview page)
ZONE_ID=your_cloudflare_zone_id_here

# Full DNS record name (e.g., api.yourdomain.com)
RECORD_NAME=api.yourdomain.com

# DNS TTL in seconds (300 = 5 minutes)
TTL=300

# Cloudflare proxy (true/false) - use false for direct IP access
PROXIED=false

# Log file location
LOG_FILE=/var/log/dns-updater.log
